# LLM Provider Configuration (OpenRouter / Local LLM seperti Ollama, LM Studio, vLLM / Hugging Face)
# Default jika kosong: https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# LLM_API_BASE_URL=http://localhost:11434/v1 # Contoh untuk Ollama
# LLM_API_BASE_URL=http://localhost:1234/v1  # Contoh untuk LM Studio
# LLM_API_KEY=                               # Kosongkan jika local LLM tanpa auth

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_chat

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (generated image storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
