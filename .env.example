# OpenRouter (server-only — never expose to the browser)
OPENROUTER_API_KEY=

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_chat

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (generated image storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
